# Copy this file to .env.local for local development.
# On Netlify, add the same variables under Site configuration → Environment variables.

# --- Database (Turso) ---
# Leave these empty locally to use a throwaway local file (data/library.db).
# Fill them in to work on the real (live site) data from your computer.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Admin sign in ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
# A long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
